{
  "entities": {
    "users": {
      "title": "User",
      "description": "User profile records",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "name": { "type": "string" },
        "email": { "type": "string" },
        "businessName": { "type": "string" },
        "phone": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["uid", "email"]
    },
    "orders": {
      "title": "Order",
      "description": "Automation orders and service requests",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "serviceName": { "type": "string" },
        "amount": { "type": "number" },
        "currency": { "type": "string" },
        "name": { "type": "string" },
        "email": { "type": "string" },
        "phone": { "type": "string" },
        "businessName": { "type": "string" },
        "requirements": { "type": "string" },
        "status": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["serviceName", "amount", "name", "email", "phone"]
    },
    "supportTickets": {
      "title": "SupportTicket",
      "description": "Customer support requests",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "subject": { "type": "string" },
        "priority": { "type": "string" },
        "message": { "type": "string" },
        "status": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["subject", "message"]
    },
    "automationConnections": {
      "title": "AutomationConnection",
      "description": "User connected automation channels",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "platform": { "type": "string" },
        "status": { "type": "string" },
        "account": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["platform", "status"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "users",
      "description": "User profiles indexed by UID"
    },
    "/orders/{orderId}": {
      "schema": "orders",
      "description": "Automation service orders"
    },
    "/supportTickets/{ticketId}": {
      "schema": "supportTickets",
      "description": "Support tickets submitted by users"
    },
    "/automationConnections/{connId}": {
      "schema": "automationConnections",
      "description": "User automation platform links"
    }
  }
}
